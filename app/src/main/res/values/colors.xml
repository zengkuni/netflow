<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <!--
        Warm paper, the Memory Garden canvas. Used as the platform
        windowBackground, so the very first frame before Compose draws is paper
        rather than OLED black, which flashed before the light-first default
        took over.
    -->
    <color name="netflow_ink">#FFF9F9F6</color>
    <!--
        Forest green, the Memory Garden action colour. Kept as a resource even
        though the Compose layer owns its own token, because the notification
        icon and any future platform chrome need a non-Compose colour.
    -->
    <color name="netflow_accent">#FF3A5A40</color>
</resources>
